{
  "name": "bio-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply ultralockin-bio --local",
    "db:migrate": "wrangler d1 migrations apply ultralockin-bio --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name ultralockin-bio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "cursor-effects": "^1.0.18",
    "lucide-react": "^1.48.0",
    "react": "^19.2.4",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.1",
    "react-parallax-tilt": "^1.7.345",
    "simple-icons": "^16.33.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "wrangler": "^4.100.0"
  }
}
